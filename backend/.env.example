# ===========================================
# SGC - Variáveis de Ambiente
# ===========================================
# Para configurar suas credenciais locais:
# 1. Copie o arquivo application.properties como "application-local.properties"
#    na pasta src/main/resources/
# 2. Preencha os valores abaixo no application-local.properties
# 3. O application-local.properties já está no .gitignore
# ===========================================

# --- Banco de Dados ---
DB_URL=jdbc:sqlserver://localhost;databaseName=condominio_db;encrypt=false
DB_USERNAME=seu_usuario_aqui
DB_PASSWORD=sua_senha_aqui

# --- JWT (use uma chave longa e aleatória, mínimo 256 bits) ---
JWT_SECRET=sua_chave_secreta_jwt_aqui

